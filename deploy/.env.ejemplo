# Configuración de ESTA casa. Se copia a la raíz como .env, que está en .gitignore:
#
#     cp deploy/.env.ejemplo .env
#
# El paso a paso completo está en docs/levantar-worker.md.
# La especificación del transporte, en contrato-worker.md v1 del repo del balanceador.
#
# Hay que completar CUATRO cosas: CASA, TP_COLA_TOKEN, TP_COLA_HOST y TP_REDIS_URL.
# Las dos credenciales las pasa el grupo por privado y NO van al repo.

CASA=casa-TUNOMBRE

# --- la cola ---------------------------------------------------------------------------
# Seed list del clúster. No son réplicas equivalentes: sólo el master atiende, y el worker
# lo descubre con GET /health y lo cachea. Esto ya está completo.
TP_COLA_URLS=http://100.78.246.64:8085,http://100.91.134.43:8085,http://100.120.186.92:8085

# Token de CONSUMIDOR (no el del balanceador). Va en el header X-Cola-Token.
TP_COLA_TOKEN=

# Tu IP de Tailscale: `tailscale ip -4`. Con esto, el worker n se presenta ante la cola
# como <TP_COLA_HOST>:811n — que tiene que ser el host:puerto gRPC REAL de tu réplica,
# porque el balanceador lo publica en su /health como "réplicas que están consumiendo".
TP_COLA_HOST=

# Descomentá esto si el puerto derivado no sirve. En Windows, Hyper-V reserva el rango
# 8054-8253 y el bind falla aunque netstat no muestre nada: ahí hay que usar 8300.
#   netsh interface ipv4 show excludedportrange protocol=tcp
# TP_COLA_CONSUMIDOR=100.104.61.29:8300

# Un hilo por worker: un worker de N hilos es N tareas en riesgo cuando se muere. Se escala
# con más procesos, no con más hilos. La espera es el long-poll; el contrato la topa en 30.
TP_COLA_HILOS=1
TP_COLA_ESPERA=8

# Major del contrato que implementa este worker. Si GET /health declara otro, el worker no
# arranca — a propósito: responder con campos que ya no significan lo mismo es peor.
# TP_COLA_CONTRATO=1

# Sólo si el otro equipo cambia el header de la credencial.
# TP_COLA_AUTH=X-Cola-Token
# TP_COLA_ESQUEMA=

# --- la base compartida ----------------------------------------------------------------
# UNA sola para todo el TP. Si esto apuntara a una base local, lo que se dé de alta por la
# cola no lo encontraría nadie más — y eso no se nota hasta que alguien lo busca.
TP_REDIS_URL=
